{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "API error response",
  "description": "Тело ошибки weatherapi.com: {\"error\": {\"code\": <int>, \"message\": <string>}}",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}